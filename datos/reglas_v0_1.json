  "victory": {
    "scope": "primer mazo sin neutrales",
    "evaluate_after": [
      "all_night_effects_committed",
      "vote_resolution"
    ],
    "ordered_rules": [
      {
        "condition": "alive_total == 0",
        "winner": "draw"
      },
      {
        "condition": "alive_impostors == 0 and alive_innocents > 0",
        "winner": "innocent"
      },
      {
        "condition": "alive_impostors > 0 and alive_impostors >= alive_innocents",
        "winner": "impostor"
      },
      {
        "condition": "otherwise",
        "winner": null
      }
    ],
    "team_dead_members_share_win": true,
    "parity_is_lobo_proposal": true
